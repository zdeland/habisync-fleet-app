{
  "compilerOptions": {
    "target": "es5",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // supabase/functions/**: Deno Edge Functions (globals like `Deno.*` and
  // bare/remote-URL imports aren't valid under this Next.js/Node project) —
  // EXCEPT _shared/, which stays plain dependency-free TS reachable here so
  // `tsx` (this repo's test runner) can still resolve
  // test/climateDetection.test.ts's relative import into it; `exclude`
  // below only affects the tsc project, not tsx's own module resolution.
  "exclude": ["node_modules", "supabase/functions/climate-alerts"]
}
